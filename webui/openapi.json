{
  "openapi": "3.1.0",
  "info": {
    "title": "U-Fanctl API",
    "description": "万由 NAS 风扇控制服务的 HTTP 与 WebSocket 接口。",
    "version": "1.1.1"
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Login",
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Logout",
        "operationId": "logout_api_v1_auth_logout_post",
        "parameters": [
          {
            "name": "session_id",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/session": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Session",
        "operationId": "session_api_v1_auth_session_get",
        "parameters": [
          {
            "name": "session_id",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/password": {
      "put": {
        "tags": [
          "auth"
        ],
        "summary": "Update Password",
        "operationId": "update_password_api_v1_auth_password_put",
        "parameters": [
          {
            "name": "session_id",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Session Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordUpdate"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/system": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Get System",
        "operationId": "get_system_api_v1_system_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemInfo"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "system"
        ],
        "summary": "Update System",
        "operationId": "update_system_api_v1_system_put",
        "parameters": [
          {
            "name": "session_id",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Session Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SystemUpdate"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/control": {
      "get": {
        "tags": [
          "control"
        ],
        "summary": "Get Control",
        "operationId": "get_control_api_v1_control_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ControlSettings"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "control"
        ],
        "summary": "Update Control",
        "operationId": "update_control_api_v1_control_put",
        "parameters": [
          {
            "name": "session_id",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Session Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ControlUpdate"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/curve": {
      "get": {
        "tags": [
          "curve"
        ],
        "summary": "Get Curve",
        "operationId": "get_curve_api_v1_curve_get",
        "parameters": [
          {
            "name": "defaults",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Defaults"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurveSettings"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "curve"
        ],
        "summary": "Update Curve",
        "operationId": "update_curve_api_v1_curve_put",
        "parameters": [
          {
            "name": "session_id",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Session Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CurveSettings"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/temperature": {
      "get": {
        "tags": [
          "temperature"
        ],
        "summary": "Get Temperature",
        "operationId": "get_temperature_api_v1_temperature_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TemperatureSettings"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "temperature"
        ],
        "summary": "Update Temperature",
        "operationId": "update_temperature_api_v1_temperature_put",
        "parameters": [
          {
            "name": "session_id",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Session Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TemperatureSettings"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/device": {
      "get": {
        "tags": [
          "device"
        ],
        "summary": "Get Device",
        "operationId": "get_device_api_v1_device_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceStatus"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ControlSettings": {
        "properties": {
          "manual": {
            "type": "boolean",
            "title": "Manual"
          },
          "manual_speed": {
            "type": "integer",
            "title": "Manual Speed"
          }
        },
        "type": "object",
        "required": [
          "manual",
          "manual_speed"
        ],
        "title": "ControlSettings"
      },
      "ControlUpdate": {
        "properties": {
          "manual": {
            "type": "boolean",
            "title": "Manual"
          },
          "manual_speed": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 5.0,
            "title": "Manual Speed"
          }
        },
        "type": "object",
        "required": [
          "manual",
          "manual_speed"
        ],
        "title": "ControlUpdate"
      },
      "CurveSettings": {
        "properties": {
          "t30": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "T30"
          },
          "t40": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "T40"
          },
          "t50": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "T50"
          },
          "t60": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "T60"
          },
          "t70": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "T70"
          },
          "t80": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "T80"
          },
          "t90": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "T90"
          },
          "t100": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "T100"
          }
        },
        "type": "object",
        "required": [
          "t30",
          "t40",
          "t50",
          "t60",
          "t70",
          "t80",
          "t90",
          "t100"
        ],
        "title": "CurveSettings"
      },
      "DeviceStatus": {
        "properties": {
          "i2c_valid": {
            "type": "boolean",
            "title": "I2C Valid"
          }
        },
        "type": "object",
        "required": [
          "i2c_valid"
        ],
        "title": "DeviceStatus"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "password"
        ],
        "title": "LoginRequest"
      },
      "PasswordUpdate": {
        "properties": {
          "old_password": {
            "type": "string",
            "title": "Old Password"
          },
          "new_password": {
            "type": "string",
            "maxLength": 16,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9]+$",
            "title": "New Password"
          }
        },
        "type": "object",
        "required": [
          "old_password",
          "new_password"
        ],
        "title": "PasswordUpdate"
      },
      "SystemInfo": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "title",
          "version"
        ],
        "title": "SystemInfo"
      },
      "SystemUpdate": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "title": "Title"
          }
        },
        "type": "object",
        "required": [
          "title"
        ],
        "title": "SystemUpdate"
      },
      "TemperatureSettings": {
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "cpu",
              "hdd"
            ],
            "title": "Source"
          },
          "interval": {
            "type": "integer",
            "maximum": 60.0,
            "minimum": 1.0,
            "title": "Interval"
          }
        },
        "type": "object",
        "required": [
          "source",
          "interval"
        ],
        "title": "TemperatureSettings"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
  "tags": [
    {
      "name": "auth",
      "description": "登录、登出、会话校验与修改密码"
    },
    {
      "name": "system",
      "description": "系统信息与标题设置"
    },
    {
      "name": "control",
      "description": "手动/自动风扇控制"
    },
    {
      "name": "curve",
      "description": "温度-转速曲线"
    },
    {
      "name": "temperature",
      "description": "温度源与采集周期"
    },
    {
      "name": "device",
      "description": "设备状态"
    },
    {
      "name": "websocket",
      "description": "WebSocket 状态推送"
    }
  ]
}
